{
  "name": "van-life",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "VITE_ANALYZE=true varlock run -- react-router build",
    "build": "varlock run -- react-router build",
    "check": "ultracite check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "bun run scripts/flatten-d1-migrations.ts && wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "bun run scripts/flatten-d1-migrations.ts && wrangler d1 migrations apply DB --remote",
    "db:optimize:local": "wrangler d1 execute DB --local --command='PRAGMA optimize'",
    "db:optimize:remote": "wrangler d1 execute DB --remote --command='PRAGMA optimize'",
    "db:seed": "bun run app/db/seed.ts",
    "db:seed:remote": "varlock run -- bun run app/db/seed.ts --remote",
    "db:studio:local": "drizzle-kit studio --config drizzle.local.config.ts",
    "db:studio:remote": "varlock run -- drizzle-kit studio",
    "deploy:project": "varlock-wrangler deploy",
    "deploy:upload": "varlock-wrangler versions upload",
    "deploy:versions": "varlock-wrangler versions deploy",
    "dev": "varlock run -- react-router dev",
    "devtools": "varlock run -- vite-devtools",
    "doctor": "ultracite doctor",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fix": "ultracite fix",
    "prepare": "husky",
    "preview": "varlock run -- vite preview",
    "react-doctor": "react-doctor",
    "test": "bun test",
    "typecheck": "bun run typegen && tsc",
    "typegen": "varlock-wrangler types && react-router typegen",
    "ultracite:upgrade": "bun x ultracite@latest init --pm bun --linter biome --agents cursor-cli --editors cursor --hooks cursor --frameworks remix --quiet"
  },
  "overrides": {
    "@babel/core": "8.0.1",
    "@opentelemetry/core": "2.10.0",
    "@remix-run/server-runtime": "2.17.5",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "nanoid": "3.3.17",
    "picomatch": "4.0.5",
    "postcss": "8.5.25",
    "turbo-stream": "3.2.0",
    "undici": "7.29.0"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@better-auth/drizzle-adapter": "1.7.0-rc.3",
    "@forge42/seo-tools": "1.4.5",
    "@varlock/bitwarden-plugin": "2.0.0",
    "arktype": "2.2.3",
    "better-auth": "1.7.0-rc.3",
    "cnfast": "0.1.0",
    "cva": "1.0.0-beta.8",
    "date-fns": "5.0.0-alpha.0",
    "drizzle-orm": "1.0.0-rc.4",
    "isbot": "5.2.1",
    "lucide-react": "1.28.0",
    "nuqs": "2.9.5",
    "react": "19.3.0-canary-c0cd4d5d-20260527",
    "react-dom": "19.3.0-canary-c0cd4d5d-20260527",
    "react-router": "8.3.0",
    "recharts": "3.10.1",
    "uuidv7": "1.2.1",
    "varlock": "1.16.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@biomejs/biome": "2.5.6",
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260804.1",
    "@fontsource-variable/inter": "5.3.0",
    "@react-router/dev": "8.3.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@varlock/cloudflare-integration": "1.4.0",
    "@vitejs/devtools": "0.4.12",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "fallow": "3.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "react-doctor": "0.9.5",
    "rollup-plugin-visualizer": "7.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.10.1",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "trustedDependencies": []
}
