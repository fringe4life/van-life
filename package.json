{
  "name": "van-life",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "VITE_ANALYZE=true varlock run -- react-router build",
    "assert:panda-cva": "bun run scripts/assert-no-panda-cva-runtime.ts",
    "audit": "bun run audit:prod && bun run audit:all",
    "audit:all": "bun audit --audit-level=high",
    "audit:prod": "bun audit --production --audit-level=low",
    "build": "varlock run -- react-router build",
    "check": "ultracite check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "bun run scripts/flatten-d1-migrations.ts && wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "bun run scripts/flatten-d1-migrations.ts && wrangler d1 migrations apply DB --remote",
    "db:optimize:local": "wrangler d1 execute DB --local --command='PRAGMA optimize'",
    "db:optimize:remote": "wrangler d1 execute DB --remote --command='PRAGMA optimize'",
    "db:seed:local": "bun run app/db/seed.ts",
    "db:seed:remote": "varlock run -- bun run app/db/seed.ts --remote",
    "db:studio:local": "drizzle-kit studio --config drizzle.local.config.ts",
    "db:studio:remote": "varlock run -- drizzle-kit studio",
    "dedupe": "bun dedupe",
    "dedupe:check": "bun dedupe --check",
    "deploy:project": "varlock-wrangler deploy",
    "deploy:upload": "varlock-wrangler versions upload",
    "deploy:versions": "varlock-wrangler versions deploy",
    "dev": "varlock run -- react-router dev",
    "devtools": "varlock run -- vite-devtools",
    "doctor": "ultracite doctor",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fix": "ultracite fix",
    "prepare": "husky && panda codegen",
    "preview": "varlock run -- vite preview",
    "react-doctor": "react-doctor --verbose --scope changed",
    "test": "bun test",
    "typecheck": "VARLOCK_ENV=test bun run typegen && tsc",
    "typegen": "VARLOCK_ENV=test varlock-wrangler types && react-router typegen",
    "ultracite:upgrade": "ultracite upgrade --pm bun"
  },
  "overrides": {
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@opentelemetry/core": "2.10.0",
    "body-parser": "2.4.0",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.9",
    "hono": "4.13.13",
    "ip-address": "10.7.4",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "turbo-stream": "3.2.1",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.26",
    "@chartlite/core": "1.1.0",
    "@chartlite/react": "1.1.0",
    "@forge42/seo-tools": "1.4.5",
    "@varlock/bitwarden-plugin": "2.0.3",
    "better-auth": "1.7.25",
    "drizzle-orm": "1.0.0-rc.5",
    "invokers-polyfill": "1.0.4",
    "isbot": "5.2.3",
    "nuqs": "2.10.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "uuidv7": "1.2.1",
    "valibot": "1.5.0",
    "varlock": "1.25.0"
  },
  "devDependencies": {
    "@acusti/vite-plugin-react-compiler": "0.12.0",
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/workers-types": "5.20261117.1",
    "@happy-dom/global-registrator": "21.0.4",
    "@pandacss/dev": "2.5.0",
    "@pandacss/mcp": "2.5.0",
    "@pandacss/preset-base": "2.6.0",
    "@pandacss/preset-panda": "2.5.0",
    "@pandacss/vite": "2.5.0",
    "@react-router/dev": "8.5.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@varlock/cloudflare-integration": "1.6.4",
    "@vitejs/devtools": "0.8.2",
    "@vitejs/devtools-rolldown": "0.8.2",
    "@vitejs/devtools-vite": "0.8.2",
    "drizzle-kit": "1.0.0-rc.5",
    "fallow": "3.44.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "react-doctor": "0.9.23",
    "typescript": "7.1.0-dev.20261116.1",
    "ultracite": "^8.2.1",
    "vite": "8.3.8",
    "wrangler": "4.161.0"
  },
  "engines": {
    "node": ">=22"
  },
  "trustedDependencies": []
}
