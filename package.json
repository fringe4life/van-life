{
  "name": "van-life",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "VITE_ANALYZE=true varlock run -- react-router build",
    "build": "varlock run -- react-router build",
    "check": "ultracite check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "bun run scripts/flatten-d1-migrations.ts && wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "bun run scripts/flatten-d1-migrations.ts && wrangler d1 migrations apply DB --remote",
    "db:optimize:local": "wrangler d1 execute DB --local --command='PRAGMA optimize'",
    "db:optimize:remote": "wrangler d1 execute DB --remote --command='PRAGMA optimize'",
    "db:seed:local": "bun run app/db/seed.ts",
    "db:seed:remote": "varlock run -- bun run app/db/seed.ts --remote",
    "db:studio:local": "drizzle-kit studio --config drizzle.local.config.ts",
    "db:studio:remote": "varlock run -- drizzle-kit studio",
    "deploy:project": "varlock-wrangler deploy",
    "deploy:upload": "varlock-wrangler versions upload",
    "deploy:versions": "varlock-wrangler versions deploy",
    "dev": "varlock run -- react-router dev",
    "devtools": "varlock run -- vite-devtools",
    "doctor": "ultracite doctor",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fix": "ultracite fix",
    "prepare": "husky && panda build",
    "preview": "varlock run -- vite preview",
    "react-doctor": "react-doctor --verbose --scope changed",
    "test": "bun test",
    "typecheck": "VARLOCK_ENV=test bun run typegen && tsc",
    "typegen": "VARLOCK_ENV=test varlock-wrangler types && react-router typegen",
    "ultracite:upgrade": "ultracite upgrade --pm bun"
  },
  "overrides": {
    "@opentelemetry/core": "2.10.0",
    "fast-uri": "3.1.6",
    "qs": "6.16.0",
    "turbo-stream": "3.2.1"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@forge42/seo-tools": "1.4.5",
    "@tanstack/charts": "0.18.0",
    "@varlock/bitwarden-plugin": "2.0.1",
    "better-auth": "1.7.5",
    "date-fns": "5.0.0-alpha.0",
    "drizzle-orm": "1.0.0-rc.4",
    "invokers-polyfill": "1.0.4",
    "isbot": "5.2.2",
    "lucide-react": "1.47.0",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "uuidv7": "1.2.1",
    "valibot": "1.5.0",
    "varlock": "1.20.0"
  },
  "devDependencies": {
    "@acusti/vite-plugin-react-compiler": "0.6.0",
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vite-plugin": "1.56.0",
    "@cloudflare/workers-types": "5.20260921.1",
    "@fontsource-variable/inter": "5.3.0",
    "@happy-dom/global-registrator": "20.14.5",
    "@pandacss/dev": "2.0.0-beta.18",
    "@pandacss/mcp": "2.0.0-beta.18",
    "@pandacss/preset-base": "2.0.0-beta.18",
    "@pandacss/preset-panda": "2.0.0-beta.18",
    "@react-router/dev": "8.4.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@varlock/cloudflare-integration": "1.6.0",
    "@vitejs/devtools": "0.7.5",
    "@vitejs/devtools-rolldown": "0.7.5",
    "@vitejs/devtools-vite": "0.7.5",
    "drizzle-kit": "1.0.0-rc.4",
    "fallow": "3.27.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "react-doctor": "0.9.14",
    "typescript": "7.0.2",
    "ultracite": "^7.12.0",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  },
  "trustedDependencies": []
}
