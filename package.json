{
  "name": "van-life",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "VITE_ANALYZE=true varlock run -- react-router build",
    "build": "varlock run -- react-router build",
    "check": "ultracite check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "bun run scripts/flatten-d1-migrations.ts && wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "bun run scripts/flatten-d1-migrations.ts && wrangler d1 migrations apply DB --remote",
    "db:optimize:local": "wrangler d1 execute DB --local --command='PRAGMA optimize'",
    "db:optimize:remote": "wrangler d1 execute DB --remote --command='PRAGMA optimize'",
    "db:seed": "bun run app/db/seed.ts",
    "db:seed:remote": "varlock run -- bun run app/db/seed.ts --remote",
    "db:studio:local": "drizzle-kit studio --config drizzle.local.config.ts",
    "db:studio:remote": "varlock run -- drizzle-kit studio",
    "deploy:project": "varlock-wrangler deploy",
    "deploy:upload": "varlock-wrangler versions upload",
    "deploy:versions": "varlock-wrangler versions deploy",
    "dev": "varlock run -- react-router dev",
    "devtools": "varlock run -- vite-devtools",
    "doctor": "ultracite doctor",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fix": "ultracite fix",
    "prepare": "husky && panda build",
    "preview": "varlock run -- vite preview",
    "react-doctor": "react-doctor --verbose --scope changed",
    "test": "bun test",
    "typecheck": "VARLOCK_ENV=test bun run typegen && tsc",
    "typegen": "VARLOCK_ENV=test varlock-wrangler types && react-router typegen",
    "ultracite:upgrade": "bun x ultracite@latest init --pm bun --linter biome --agents cursor-cli --editors cursor zed --hooks cursor --frameworks remix react --quiet"
  },
  "overrides": {
    "@opentelemetry/core": "2.10.0",
    "fast-uri": "3.1.6",
    "qs": "6.16.0",
    "turbo-stream": "3.2.1"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@forge42/seo-tools": "1.4.5",
    "@tanstack/charts": "0.16.0",
    "@varlock/bitwarden-plugin": "2.0.1",
    "better-auth": "1.7.2",
    "date-fns": "5.0.0-alpha.0",
    "drizzle-orm": "1.0.0-rc.4",
    "invokers-polyfill": "1.0.4",
    "isbot": "5.2.2",
    "lucide-react": "1.38.0",
    "nuqs": "2.10.1",
    "react": "19.3.0-canary-eb8feb71-20260814",
    "react-dom": "19.3.0-canary-eb8feb71-20260814",
    "react-router": "8.3.1",
    "uuidv7": "1.2.1",
    "valibot": "1.4.2",
    "varlock": "1.18.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@biomejs/biome": "2.5.11",
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260901.1",
    "@fontsource-variable/inter": "5.3.0",
    "@pandacss/dev": "2.0.0-beta.15",
    "@pandacss/mcp": "2.0.0-beta.15",
    "@pandacss/preset-base": "2.0.0-beta.15",
    "@pandacss/preset-panda": "2.0.0-beta.15",
    "@react-router/dev": "8.3.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@varlock/cloudflare-integration": "1.5.1",
    "@vitejs/devtools": "0.6.2",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "fallow": "3.22.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "react-doctor": "0.9.13",
    "rolldown": "1.2.6",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "7.0.2",
    "ultracite": "7.10.7",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "trustedDependencies": []
}
