{
  "extends": [
    "ultracite/biome/react",
    "ultracite/biome/core",
    "ultracite/biome/remix"
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": ["app/**/*", "!!.cursor/hooks/*", "!fallow-viz.html"],
    "ignoreUnknown": false
  },
  "overrides": [
    {
      "includes": ["env.d.ts"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "app/features/host/components/host-nav/host-mobile-nav.tsx",
        "app/features/navigation/components/mobile-nav.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAttribute": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
