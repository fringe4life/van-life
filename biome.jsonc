{
  "extends": [
    "ultracite/biome/react",
    "ultracite/biome/core",
    "ultracite/biome/remix"
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "app/**/*",
      "theme/**/*",
      "!!.cursor/hooks/*",
      "!fallow-viz.html"
    ],
    "ignoreUnknown": false
  },
  "overrides": [
    {
      "includes": ["env.d.ts"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "app/features/host/components/host-nav/host-mobile-nav.tsx",
        "app/navigation/components/mobile-nav.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAttribute": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "rules": {
      "correctness": {
        /*
         * Workaround: disable noUndeclaredDependencies so Panda's generated
         * `styled-system/*` import map (tsconfig paths → gitignored outdir) is
         * not treated as a missing package.json dependency. Wrong long-term:
         * the rule should honor tsconfig paths (or an allowlist) instead of us
         * turning it off.
         *
         * Still required on @biomejs/biome@2.5.15 (+ ultracite^8 presets that
         * enable the rule) with @pandacss/*@2.2.0 and importMap/outdir
         * `styled-system`. Drop when Biome resolves tsconfig paths for this
         * rule; re-enable and re-verify `bun run check` on styled-system imports.
         *
         * @see https://github.com/biomejs/biome/issues/10607 — open
         * @see https://github.com/biomejs/biome/pull/10620 — closed unmerged
         * @see https://github.com/fringe4life/van-life/issues/353 — tracking
         */
        "noUndeclaredDependencies": "off"
      },
      "style": {
        "useDomQuerySelector": "off"
      }
    }
  }
}
