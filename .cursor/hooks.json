{
  "version": 1,
  "ultracite": {
    "rules": [
      {
        "path": ".cursor/rules/ultracite.mdc",
        "globs": "**/*.{ts,tsx,js,jsx,json,jsonc,html,vue,svelte,astro,css,yaml,yml,graphql,gql,md,mdx,grit}",
        "alwaysApply": false
      }
    ],
    "tasks": {
      "check": "bun check",
      "fix": "bun fix",
      "doctor": "bun doctor"
    }
  },
  "hooks": {
    "afterFileEdit": [
      {
        "command": "bun fix"
      }
    ],
    "postToolUse": [],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/fallow-audit.mjs",
        "timeout": 120,
        "matcher": "git commit|git push"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/react-doctor.mjs",
        "timeout": 120
      }
    ]
  }
}
