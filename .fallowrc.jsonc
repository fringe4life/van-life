{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "app/root.{ts,tsx,js,jsx}",
    "panda.config.ts",
    "vite.config.ts",
    "workers/app.ts",
    ".env.schema"
  ],
  "dynamicallyLoaded": [
    "app/features/host/components/bar-chart/bar-chart.tsx",
    "app/test/happydom.ts",
    "app/test/testing-library.ts"
  ],
  "typeAware": {
    "enabled": true,
    // complete fails the run when the TS companion is partial/unavailable
    // (CI Action has no bun install; worker-configuration.d.ts is generated).
    // best-effort still runs checker evidence; tsc owns compiler correctness.
    "require": "best-effort",
    "projects": ["tsconfig.json"]
  },
  "rules": {
    // Soft gate while boundaries + cleanup iron out — audit warn ≠ CI fail
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "warn",
    "unused-enum-members": "warn",
    "unused-class-members": "warn",
    "unresolved-imports": "warn",
    "unlisted-dependencies": "warn",
    "duplicate-exports": "warn",
    "circular-dependencies": "warn",
    "re-export-cycle": "warn",
    "boundary-violation": "warn",
    "prop-drilling": "warn",
    "thin-wrapper": "warn",
    "duplicate-prop-shape": "warn",
    "unused-dependency-overrides": "off",
    "private-type-leaks": "off"
  },
  "ignorePatterns": ["worker-configuration.d.ts", "doctor.config.ts"],
  "ignoreDependencies": [
    "@acusti/vite-plugin-react-compiler",
    "isbot",
    "react-doctor",
    "@varlock/bitwarden-plugin",
    "@cloudflare/vite-plugin",
    "@fontsource-variable/inter",
    "@pandacss/mcp",
    // Build-time only: route/vite config (app/routes.ts, vite.config.ts, react-router.config.ts)
    "@react-router/dev",
    "wrangler",
    "rolldown"
  ],
  "duplicates": {
    "enabled": true,
    "minOccurrences": 3,
    "minLines": 15
  },
  "security": {
    "categories": {
      "include": [
        "dangerous-html",
        "open-redirect",
        "sql-injection",
        "ssrf",
        "path-traversal"
      ]
    }
  },
  "health": {
    "maxCognitive": 12,
    "maxCyclomatic": 12,
    "maxCrap": 55,
    // Tiny name map: 5 one-liners / ~11 LOC trips split_high_impact density.
    // Inline `fallow-ignore-file complexity` does not drop --targets (file scores stay).
    "ignore": ["app/features/vans/components/van-view-transitions.ts"],
    "thresholdOverrides": [
      {
        "files": ["app/db/seed.ts"],
        "functions": ["main", "rentsWithIds"],
        "maxCrap": 150,
        "reason": "seed CLI, estimated CRAP, no Istanbul"
      }
    ]
  },
  // Bulletproof + path overlays: repo is `app/` not `src/{app,features,server}`.
  // Replace all four preset zone names so leftover `{rootDir}/app/**` cannot swallow files.
  // Cross-cuts live as kit modules (`app/pagination|navigation|seo` → shared, `app/middleware` → server).
  // host→vans is the only sibling-feature edge. shared→server covers db types + `*.server.ts` in lib.
  "boundaries": {
    "preset": "bulletproof",
    "zones": [
      {
        "name": "app",
        "patterns": [
          "app/routes/**",
          "app/root.tsx",
          "app/entry.client.tsx",
          "app/entry.server.tsx",
          "app/routes.ts"
        ]
      },
      {
        "name": "features",
        "patterns": ["app/features/**"],
        "autoDiscover": ["app/features"]
      },
      {
        "name": "shared",
        "patterns": [
          "app/components/**",
          "app/lib/**",
          "app/utils/**",
          "app/hooks/**",
          "app/constants/**",
          "app/types/**",
          "app/dal/**",
          "app/styles.ts",
          "app/pagination/**",
          "app/navigation/**",
          "app/seo/**"
        ]
      },
      {
        "name": "server",
        "patterns": ["app/db/**", "app/middleware/**", "workers/**"]
      }
    ],
    "rules": [
      {
        "from": "features/host",
        "allow": ["shared", "server", "features/vans"]
      },
      {
        "from": "shared",
        "allow": ["server"]
      }
    ]
  }
}
